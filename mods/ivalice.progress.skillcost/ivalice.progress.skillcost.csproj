<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.9.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RELOADEDIIMODS)/ivalice.progress.skillcost</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="fftivc.utility.modloader.Interfaces" Version="1.4.0" />
    <None Update="ModConfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/icon.png" Link="Preview.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckModDestination" BeforeTargets="Build">
    <Error Condition="'$(RELOADEDIIMODS)' == ''" Text="Set RELOADEDIIMODS to the mod output directory." />
  </Target>
</Project>

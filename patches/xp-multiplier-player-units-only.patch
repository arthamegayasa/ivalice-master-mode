+    // Battle unit table: 21 records of 0x200 bytes. Byte 0x1EE holds the unit's own flags;
+    // team bits 0x30 are zero for units on the player's side (party members and guests).
+    private const int UnitCount = 21;
+    private const int UnitSize = 0x200;
+    private const int UnitFlagsOffset = 0x1EE;
+    private const byte UnitTeamMask = 0x30;
+    private nuint _unitTableAddress;
+
+    /// <summary>
+    /// Reads the unit table address from the "lea rax, [rip+disp]" the hooked function itself uses.
+    /// </summary>
+    private unsafe void LocateUnitTable(nuint functionAddress, int leaOffset)
+    {
+        var lea = (byte*) functionAddress + leaOffset;
+        if (lea[0] != 0x48 || lea[1] != 0x8D || lea[2] != 0x05)
+        {
+            _logger.WriteLine($"[{_modConfig.ModId}] Unit table not found; with 'Player units only' on, the multiplier will apply to no one.", Color.OrangeRed);
+            return;
+        }
+        _unitTableAddress = (nuint) (lea + 7 + *(int*) (lea + 3));
+        _logger.WriteLine($"[{_modConfig.ModId}] Found unit table at 0x{_unitTableAddress:X}.");
+    }
+
+    /// <summary>Whether the multiplier applies to the unit in this battle slot.</summary>
+    private unsafe bool AppliesTo(int id)
+    {
+        if (!_configuration.PlayerUnitsOnly) return true;
+        // Without a way to tell the sides apart, multiply for no one rather than for the enemy too.
+        if (_unitTableAddress == 0 || id < 0 || id >= UnitCount) return false;
+        var flags = *((byte*) _unitTableAddress + id * UnitSize + UnitFlagsOffset);
+        return (flags & UnitTeamMask) == 0;
+    }
